# G-Talk works with either or both of these. When both are set, Grok answers
# first and Gemini steps in if Grok fails (flip with GTALK_PROVIDER=gemini).

# xAI key: https://console.x.ai
XAI_API_KEY=

# Google AI Studio key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional overrides
# GTALK_PROVIDER=grok            # or gemini: which provider to try first
# XAI_CHAT_MODEL=grok-4-fast
# XAI_API_BASE=https://api.x.ai/v1
# GEMINI_CHAT_MODEL=gemini-3.6-flash
# GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta

# Retrieval (RAG) for G-Talk and the site agent. With GEMINI_API_KEY set the
# knowledge base is also searched by meaning (embeddings); without it,
# keyword search alone is used. The agent still navigates with no key at all.
# GEMINI_EMBED_MODEL=gemini-embedding-001
